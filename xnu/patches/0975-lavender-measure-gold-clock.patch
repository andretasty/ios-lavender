diff --git a/bsd/dev/sweet_goldclk.c b/bsd/dev/sweet_goldclk.c
new file mode 100644
index 0000000..dba5b89
--- /dev/null
+++ b/bsd/dev/sweet_goldclk.c
@@ -0,0 +1,125 @@
+/*
+ * lavender: measure the real Gold clock. Reads the cluster RCG and PLL, then
+ * counts CPU cycles (PMCCNTR) against the 19.2 MHz system counter.
+ * Boot-arg goldl=<L> moves the cluster to its PLL at L x 19.2 MHz. No voltage
+ * change: the rail stays as the bootloader left it, so only use L values whose
+ * stock corner ceiling the rail meets (stock: 0x3a = 1113.6 MHz, 724 mV).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <mach/mach_time.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern kern_return_t thread_terminate(thread_t);
+void sweet_goldclk_init(void);
+
+#define PERF_RCG_PA     0x17810000u     /* CMD +0x1050, CFG +0x1054 */
+#define PERF_PLL_PA     0x17814000u     /* PLL at +0x2000: MODE +0, L +4, STATUS +0x2c */
+
+static int goldclk_chan;
+
+static void
+goldclk_rcg(vm_offset_t rcg, uint32_t cfg)
+{
+	*(volatile uint32_t *)(rcg + 0x1054) = cfg;
+	*(volatile uint32_t *)(rcg + 0x1050) |= 1u;
+	__asm__ volatile ("dsb sy");
+	for (int i = 0; i < 1000 && (*(volatile uint32_t *)(rcg + 0x1050) & 1u); i++) {
+		delay(10);
+	}
+}
+
+/* clk_osm_setup_cluster_pll order: off, L, bypass, reset released, output on, lock, then the mux. */
+static void
+goldclk_set(vm_offset_t rcg, vm_offset_t pll, uint32_t l)
+{
+	volatile uint32_t *mode = (volatile uint32_t *)(pll + 0x2000);
+	int lock = 0;
+
+	goldclk_rcg(rcg, 0x401);        /* GPLL0, where the bootloader leaves it */
+	*mode = 0;
+	*(volatile uint32_t *)(pll + 0x2004) = l;
+	*mode = 2;
+	__asm__ volatile ("dsb sy");
+	delay(1000);
+	*mode = 6;
+	__asm__ volatile ("dsb sy");
+	delay(1000);
+	*mode = 7;
+	__asm__ volatile ("dsb sy");
+	for (int i = 0; i < 1000 && !lock; i++) {
+		lock = (*(volatile uint32_t *)(pll + 0x202c) >> 16) & 1;
+		delay(10);
+	}
+	if (lock) {
+		goldclk_rcg(rcg, 0x300);
+	}
+	printf("GOLD: L=%#x lock=%d cfg=%#x\n", l, lock, *(volatile uint32_t *)(rcg + 0x1054));
+}
+
+static uint64_t
+goldclk_measure(void)
+{
+	uint64_t pmcr, c0, c1, t0, t1, ns, lim;
+	boolean_t istate = ml_set_interrupts_enabled(FALSE);
+
+	__asm__ volatile ("mrs %0, pmcr_el0" : "=r"(pmcr));
+	__asm__ volatile ("msr pmcr_el0, %0" :: "r"(pmcr | 1u));
+	__asm__ volatile ("msr pmcntenset_el0, %0" :: "r"(1ULL << 31));
+	__asm__ volatile ("isb");
+	nanoseconds_to_absolutetime(50ULL * NSEC_PER_MSEC, &lim);
+	t0 = mach_absolute_time();
+	__asm__ volatile ("mrs %0, pmccntr_el0" : "=r"(c0));
+	do {
+		t1 = mach_absolute_time();
+	} while (t1 - t0 < lim);
+	__asm__ volatile ("mrs %0, pmccntr_el0" : "=r"(c1));
+	(void)ml_set_interrupts_enabled(istate);
+	absolutetime_to_nanoseconds(t1 - t0, &ns);
+	return ns == 0 ? 0 : ((c1 - c0) * 1000ULL) / ns;
+}
+
+static void
+goldclk_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	vm_offset_t rcg = ml_io_map(PERF_RCG_PA, 0x4000);
+	vm_offset_t pll = ml_io_map(PERF_PLL_PA, 0x4000);
+	uint32_t goldl = 0;
+
+	for (int i = 0; i < 3; i++) {
+		uint64_t deadline;
+		clock_interval_to_deadline(20, NSEC_PER_SEC, &deadline);
+		(void)assert_wait_deadline(&goldclk_chan, THREAD_UNINT, deadline);
+		thread_block(THREAD_CONTINUE_NULL);
+		printf("GOLD: %llu MHz\n", goldclk_measure());
+		if (i == 0 && rcg && pll) {
+			printf("GOLD: rcg cmd=%#x cfg=%#x pll mode=%#x l=%#x status=%#x\n",
+			    *(volatile uint32_t *)(rcg + 0x1050), *(volatile uint32_t *)(rcg + 0x1054),
+			    *(volatile uint32_t *)(pll + 0x2000), *(volatile uint32_t *)(pll + 0x2004),
+			    *(volatile uint32_t *)(pll + 0x202c));
+			if (PE_parse_boot_argn("goldl", &goldl, sizeof(goldl)) && goldl != 0) {
+				goldclk_set(rcg, pll, goldl);
+				printf("GOLD: now %llu MHz\n", goldclk_measure());
+			}
+		}
+	}
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_goldclk_init(void)
+{
+	thread_t thread;
+
+	if (kernel_thread_start(goldclk_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
