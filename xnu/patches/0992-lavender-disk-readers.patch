 /* lavender: read by the gpu_meas log (TopazAdreno.cpp) */
 uint64_t semmc_rd_bytes, semmc_rd_abs, semmc_wr_bytes, semmc_wr_abs;
 
+/* lavender: who reads the disk, per process, for the gpu_meas log */
+#define SEMMC_TOP 24
+static struct {
+	char name[17];
+	uint64_t kb, reqs;
+} semmc_top[SEMMC_TOP];
+void semmc_top_print(void);
+
+static void
+semmc_top_add(uint64_t bytes)
+{
+	char name[17];
+	int free_at = -1;
+
+	proc_selfname(name, sizeof(name));
+	for (int i = 0; i < SEMMC_TOP; i++) {
+		if (semmc_top[i].name[0] == 0) {
+			free_at = free_at < 0 ? i : free_at;
+		} else if (strncmp(semmc_top[i].name, name, sizeof(name)) == 0) {
+			semmc_top[i].kb += bytes >> 10;
+			semmc_top[i].reqs++;
+			return;
+		}
+	}
+	if (free_at >= 0) {
+		strlcpy(semmc_top[free_at].name, name, sizeof(name));
+		semmc_top[free_at].kb = bytes >> 10;
+		semmc_top[free_at].reqs = 1;
+	}
+}
+
+void
+semmc_top_print(void)
+{
+	char line[200];
+	int n = snprintf(line, sizeof(line), "MEAS readers:");
+
+	lck_mtx_lock(&semmc_lock);
+	for (int shown = 0; shown < 6; shown++) {
+		int best = -1;
+		for (int i = 0; i < SEMMC_TOP; i++) {
+			if (semmc_top[i].name[0] != 0 && semmc_top[i].kb != 0 && (best < 0 || semmc_top[i].kb > semmc_top[best].kb)) {
+				best = i;
+			}
+		}
+		if (best < 0 || n >= (int)sizeof(line) - 40) {
+			break;
+		}
+		n += snprintf(line + n, sizeof(line) - n, " %s %lluK/%llu", semmc_top[best].name, semmc_top[best].kb, semmc_top[best].reqs);
+		semmc_top[best].kb = 0;
+	}
+	bzero(semmc_top, sizeof(semmc_top));
+	lck_mtx_unlock(&semmc_lock);
+	printf("%s\n", line);
+}
