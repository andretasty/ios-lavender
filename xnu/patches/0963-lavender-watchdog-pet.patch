new file mode 100644
index 0000000..c3c1ba4
--- /dev/null
+++ b/bsd/dev/sweet_wdt.c
@@ -0,0 +1,77 @@
+/*
+ * lavender: pet the APSS watchdog the shim arms (ADT /sweet-wdt, ~30 s bite).
+ * A hung or panicked kernel stops petting, the watchdog resets the phone and
+ * ABL comes back in fastboot (the shim set that restart reason), so a host
+ * script can read the pstore log and boot the next kernel unattended.
+ * pexpert/arm/pe_serial.c also pets on every console write, before this
+ * thread exists.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <mach/mach_time.h>
+#include <kern/sched_prim.h>
+#include <kern/startup.h>
+#include <kern/thread.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+
+static volatile uint32_t *sweet_wdt;
+static int sweet_wdt_chan;
+
+extern void sweet_wdt_early_off(void);  /* pexpert/arm/pe_serial.c */
+
+/* boot-arg sweetwdt=<seconds>: stop petting after that long, so even a live but stuck boot ends in a reset */
+static void
+sweet_wdt_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint32_t limit = 0;
+	uint64_t start = mach_absolute_time(), limit_abs = 0;
+
+	(void)PE_parse_boot_argn("sweetwdt", &limit, sizeof(limit));
+	if (limit != 0) {
+		nanoseconds_to_absolutetime((uint64_t)limit * NSEC_PER_SEC, &limit_abs);
+	}
+	bool petting = true;
+
+	for (;;) {
+		uint64_t deadline;
+		if (petting && limit_abs != 0 && mach_absolute_time() - start >= limit_abs) {
+			printf("SWEET WDT: run limit %u s reached, letting the watchdog bite\n", limit);
+			sweet_wdt_early_off();
+			petting = false;
+		}
+		if (petting) {
+			sweet_wdt[0x04 / 4] = 1;        /* WDT0_RST */
+		}
+		clock_interval_to_deadline(5, NSEC_PER_SEC, &deadline);
+		(void)assert_wait_deadline(&sweet_wdt_chan, THREAD_UNINT, deadline);
+		thread_block(THREAD_CONTINUE_NULL);
+	}
+}
+
+static void
+sweet_wdt_init(void)
+{
+	DTEntry entry;
+	uint64_t const *reg;
+	unsigned int size;
+	thread_t thread;
+
+	if (SecureDTLookupEntry(NULL, "/sweet-wdt", &entry) != kSuccess ||
+	    SecureDTGetProperty(entry, "reg", (void const **)&reg, &size) != kSuccess || size < 16) {
+		return;
+	}
+	sweet_wdt = (volatile uint32_t *)ml_io_map(reg[0], reg[1]);
+	if (sweet_wdt == NULL) {
+		return;
+	}
+	if (kernel_thread_start(sweet_wdt_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+	printf("SWEET WDT: petting the APSS watchdog every 5 s\n");
+}
+STARTUP(EARLY_BOOT, STARTUP_RANK_LAST, sweet_wdt_init);
