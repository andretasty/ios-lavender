diff --git a/bsd/dev/sweet_wdt.c b/bsd/dev/sweet_wdt.c
new file mode 100644
index 0000000..e58722a
--- /dev/null
+++ b/bsd/dev/sweet_wdt.c
@@ -0,0 +1,125 @@
+/*
+ * lavender: pet the APSS watchdog the shim arms (ADT /sweet-wdt, ~30 s bite).
+ * A hung or panicked kernel stops petting, the watchdog resets the phone and
+ * ABL comes back in fastboot (the shim set that restart reason), so a host
+ * script can read the pstore log and boot the next kernel unattended.
+ * pexpert/arm/pe_serial.c also pets on every console write, before this
+ * thread exists.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <mach/mach_time.h>
+#include <kern/sched_prim.h>
+#include <kern/startup.h>
+#include <kern/thread.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+
+static volatile uint32_t *sweet_wdt;
+static int sweet_wdt_chan;
+static volatile uint32_t *sweet_restart_reason;
+
+/*
+ * A watchdog bite boots Android (ABL ignores the IMEM reason then), so every
+ * planned reset goes through here: IMEM restart reason "bootloader", then PSCI
+ * SYSTEM_RESET. Installed as PE_halt_restart, it also runs after a panic when
+ * the debug boot-arg lacks DB_NMI (PE_reboot_on_panic).
+ */
+extern int (*PE_halt_restart)(unsigned int type);
+
+static int
+sweet_reset_to_fastboot(__unused unsigned int type)
+{
+	if (sweet_restart_reason != NULL) {
+		*sweet_restart_reason = 0x77665500;     /* RESTART_BOOTLOADER */
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	register uint64_t x0 __asm__("x0") = 0x84000009;        /* PSCI SYSTEM_RESET */
+	__asm__ volatile ("smc #0" : "+r"(x0) : : "x1", "x2", "x3", "x4", "x5", "x6", "x7", "x8",
+	    "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+	for (;;) {
+	}
+}
+
+extern void sweet_wdt_early_off(void);  /* pexpert/arm/pe_serial.c */
+
+/* For long polling loops that may run with preemption off (bsd/dev/sweet_emmc.c). */
+void sweet_wdt_kick(void);
+
+void
+sweet_wdt_kick(void)
+{
+	if (sweet_wdt != NULL) {
+		sweet_wdt[0x04 / 4] = 1;        /* WDT0_RST */
+	}
+}
+
+/* boot-arg sweetwdt=<seconds>: stop petting after that long, so even a live but stuck boot ends in a reset */
+static void
+sweet_wdt_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint32_t limit = 0;
+	uint64_t start = mach_absolute_time(), limit_abs = 0;
+
+	(void)PE_parse_boot_argn("sweetwdt", &limit, sizeof(limit));
+	if (limit != 0) {
+		nanoseconds_to_absolutetime((uint64_t)limit * NSEC_PER_SEC, &limit_abs);
+	}
+	bool petting = true;
+
+	for (;;) {
+		uint64_t deadline;
+		if (petting && limit_abs != 0 && mach_absolute_time() - start >= limit_abs) {
+			printf("SWEET WDT: run limit %u s reached, resetting into fastboot\n", limit);
+			sweet_wdt_early_off();
+			petting = false;
+			sweet_reset_to_fastboot(0);
+		}
+		if (petting) {
+			sweet_wdt[0x04 / 4] = 1;        /* WDT0_RST */
+		}
+		static uint32_t beats;
+		if ((++beats % 3) == 0) {
+			uint64_t ns;
+			absolutetime_to_nanoseconds(mach_absolute_time() - start, &ns);
+			printf("SWEET WDT: alive %llu s\n", ns / NSEC_PER_SEC);
+		}
+		clock_interval_to_deadline(5, NSEC_PER_SEC, &deadline);
+		(void)assert_wait_deadline(&sweet_wdt_chan, THREAD_UNINT, deadline);
+		thread_block(THREAD_CONTINUE_NULL);
+	}
+}
+
+static void
+sweet_wdt_init(void)
+{
+	DTEntry entry;
+	uint64_t const *reg;
+	unsigned int size;
+	thread_t thread;
+
+	if (SecureDTLookupEntry(NULL, "/sweet-wdt", &entry) != kSuccess ||
+	    SecureDTGetProperty(entry, "reg", (void const **)&reg, &size) != kSuccess || size < 16) {
+		return;
+	}
+	sweet_wdt = (volatile uint32_t *)ml_io_map(reg[0], reg[1]);
+	if (sweet_wdt == NULL) {
+		return;
+	}
+	if (SecureDTGetProperty(entry, "restart-reason", (void const **)&reg, &size) == kSuccess && size >= 8) {
+		vm_offset_t page = ml_io_map(reg[0] & ~0xfffULL, 0x1000);
+		if (page != 0) {
+			sweet_restart_reason = (volatile uint32_t *)(page + (reg[0] & 0xfffULL));
+		}
+	}
+	PE_halt_restart = sweet_reset_to_fastboot;
+	if (kernel_thread_start(sweet_wdt_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+	printf("SWEET WDT: petting the APSS watchdog every 5 s\n");
+}
+STARTUP(EARLY_BOOT, STARTUP_RANK_LAST, sweet_wdt_init);
