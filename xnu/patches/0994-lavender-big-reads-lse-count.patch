 /*
- * One 64-bit ADMA2 descriptor right behind the bounce buffer: attr
- * valid|end|tran, length (nblk * 512, < 64 KiB), address. Points the host at it.
+ * 64-bit ADMA2 descriptors right behind the bounce buffer: attr valid|tran (end
+ * on the last), length, address. Points the host at them. 60 KB each: a length
+ * of 64 KB would be written as 0. Only the bytes in use go through the cache:
+ * cleaning the whole buffer for every command was most of a small read's cost.
+ * The stride is proved by semmc_big_read_test before more than one is used.
  */
+#define SEMMC_DESC_CHUNK        0xF000u
+static uint32_t semmc_desc_stride = 12;
+static uint32_t semmc_read_max = SEMMC_MAX_XFER_BLKS;
+
 static void
 semmc_adma_arm(uint32_t nblk)
 {
