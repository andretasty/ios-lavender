+/*
+ * lavender: reads of up to 1 MB only after this proves them: the same MiB read in 32 KB commands and in
+ * one, byte for byte, with each descriptor stride. Writes stay at 32 KB. Called with semmc_lock held.
+ */
+static void
+semmc_big_read_test(void)
+{
+	static const uint32_t strides[] = { 12, 16 };
+	const uint32_t blocks = SEMMC_DMA_SIZE / SEMMC_SECTOR;
+	uint64_t lba = semmc.part.first + 4000000;
+	char *a = semmc_log_ring, *b = semmc_log_ring + SEMMC_DMA_SIZE;
+
+	if (semmc_dma_pa == 0 || semmc_read_blocks(lba, blocks, a) != 0) {
+		SEMMC_LOG("big reads: reference read failed, staying at 32 KB");
+		return;
+	}
+	for (unsigned i = 0; i < sizeof(strides) / sizeof(strides[0]); i++) {
+		semmc_desc_stride = strides[i];
+		bzero(b, SEMMC_DMA_SIZE);
+		uint64_t t0 = mach_absolute_time(), ns;
+		int err = semmc_xfer_read(MMC_READ_MULTIPLE_BLOCK, (uint32_t)lba, blocks, b);
+		absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+		int same = err == 0 && memcmp(a, b, SEMMC_DMA_SIZE) == 0;
+		SEMMC_LOG("big read test: stride %u err %d same %d, 1 MB in %llu us", strides[i], err, same, ns / 1000);
+		if (same) {
+			semmc_read_max = blocks;
+			break;
+		}
+	}
+	if (semmc_read_max == SEMMC_MAX_XFER_BLKS) {
+		semmc_desc_stride = 12;
+		SEMMC_LOG("big reads refused, staying at 32 KB");
+	}
+	bzero(a, 2 * SEMMC_DMA_SIZE);
+}
