+	uint32_t left = nblk * SEMMC_SECTOR, used = 0;
+
+	while (left > 0) {
+		uint32_t n = left > SEMMC_DESC_CHUNK ? SEMMC_DESC_CHUNK : left;
+		volatile uint32_t *d = (volatile uint32_t *)(desc + used);
+		left -= n;
+		d[0] = (left == 0 ? 0x0023u : 0x0021u) | (n << 16);
+		d[1] = (uint32_t)pa;
+		d[2] = (uint32_t)(pa >> 32);
+		d[3] = 0;
+		pa += n;
+		used += semmc_desc_stride;
+	}
+	flush_dcache64((addr64_t)semmc_dma_pa, nblk * SEMMC_SECTOR, TRUE);
+	flush_dcache64((addr64_t)desc_pa, used + 16, TRUE);
 	semmc_w32(SDHCI_ADMA_ADDRESS, (uint32_t)desc_pa);
