 /*
  * SWEET crash report on the console. The phone has no way to get crash
@@ -886,6 +888,42 @@ sweet_crash_log(const char *name, int pid, int sig, uint64_t code, uint64_t subc
 		printf("%s\n", line);
 	}
 
+	/* lavender: which shared-cache dylib headers read back as non-Mach-O in this process */
+	if (sig == 6 && slide != 0) {
+		uint64_t base = 0x180000000ULL + slide;
+		uint32_t io[2] = { 0, 0 };
+		uint32_t bad = 0;
+		static uint32_t next;
+		uint32_t first = next;
+		uint64_t t0 = mach_absolute_time(), lim;
+		/* the full scan stalled the kernel: a slice per crash, resuming where the last one stopped */
+		nanoseconds_to_absolutetime(2ULL * NSEC_PER_SEC, &lim);
+		if (copyin((user_addr_t)(base + 0x1c0), io, sizeof(io)) == 0 && io[1] < 10000 && io[1] > 0) {
+			for (uint32_t k = 0; k < 250 && mach_absolute_time() - t0 < lim; k++) {
+				uint32_t i = next;
+				next = (next + 1) % io[1];
+				extern void sweet_wdt_kick(void);
+				sweet_wdt_kick();
+				uint64_t ii[4];
+				uint32_t magic = 0;
+				if (copyin((user_addr_t)(base + io[0] + 32ULL * i), ii, sizeof(ii)) != 0) {
+					break;
+				}
+				int e = copyin((user_addr_t)(ii[0] + slide), &magic, sizeof(magic));
+				if (e == 0 && magic == 0xfeedfacf) {
+					continue;
+				}
+				if (bad++ < 12) {
+					char path[120] = "?";
+					(void)copyinstr((user_addr_t)(base + (uint32_t)ii[3]), path, sizeof(path), NULL);
+					printf("CRASH %s dsc %s @0x%llx e%d magic 0x%x\n", name, path,
+					    (unsigned long long)ii[0], e, magic);
+				}
+			}
+		}
+		printf("CRASH %s dsc checked images %u..%u of %u, %u bad\n", name, first, next, io[1], bad);
+	}
+
