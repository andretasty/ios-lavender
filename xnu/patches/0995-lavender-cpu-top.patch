diff --git a/bsd/dev/sweet_cputop.c b/bsd/dev/sweet_cputop.c
new file mode 100644
index 0000000..d5fdaf4
--- /dev/null
+++ b/bsd/dev/sweet_cputop.c
@@ -0,0 +1,94 @@
+/*
+ * lavender: who uses the CPUs. Between two calls, per process: the task's total
+ * user + system time (Mach absolute units, fill_taskprocinfo), as a percentage
+ * of one core. Idle threads belong to kernel_task, so with 4 cores the sum is
+ * about 400 and kernel_task's share is mostly idle time. For the gpu_meas log.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/proc_internal.h>
+#include <sys/bsdtask_info.h>
+#include <sys/proc_info.h>
+#include <kern/clock.h>
+#include <mach/mach_time.h>
+
+void sweet_cputop_print(void);
+
+#define TOP_SLOTS 512
+static struct {
+	int pid;
+	uint64_t last;
+	uint64_t delta;
+	char name[17];
+} top[TOP_SLOTS];
+
+static int
+top_visit(proc_t p, __unused void *arg)
+{
+	struct proc_taskinfo_internal info;
+	task_t task = proc_task(p);
+	int pid = proc_pid(p), at = -1;
+
+	if (task == NULL) {
+		return PROC_RETURNED;
+	}
+	bzero(&info, sizeof(info));
+	fill_taskprocinfo(task, &info);
+	uint64_t now = info.pti_total_user + info.pti_total_system;
+	for (int i = 0; i < TOP_SLOTS; i++) {
+		if (top[i].pid == pid && top[i].name[0] != 0) {
+			at = i;
+			break;
+		}
+		if (at < 0 && top[i].name[0] == 0) {
+			at = i;
+		}
+	}
+	if (at < 0) {
+		return PROC_RETURNED;
+	}
+	if (top[at].name[0] == 0 || top[at].pid != pid) {
+		top[at].pid = pid;
+		top[at].last = 0;
+		proc_name(pid, top[at].name, sizeof(top[at].name));
+		if (top[at].name[0] == 0) {
+			strlcpy(top[at].name, "?", sizeof(top[at].name));
+		}
+	}
+	top[at].delta = now > top[at].last ? now - top[at].last : 0;
+	top[at].last = now;
+	return PROC_RETURNED;
+}
+
+void
+sweet_cputop_print(void)
+{
+	static uint64_t then;
+	uint64_t t = mach_absolute_time(), window = t - then, total = 0;
+	char line[220];
+
+	then = t;
+	proc_iterate(PROC_ALLPROCLIST, top_visit, NULL, NULL, NULL);
+	int n = snprintf(line, sizeof(line), "MEAS cpu:");
+	for (int shown = 0; shown < 8; shown++) {
+		int best = -1;
+		for (int i = 0; i < TOP_SLOTS; i++) {
+			if (top[i].name[0] != 0 && top[i].delta != 0 && (best < 0 || top[i].delta > top[best].delta)) {
+				best = i;
+			}
+		}
+		if (best < 0 || n > (int)sizeof(line) - 30) {
+			break;
+		}
+		n += snprintf(line + n, sizeof(line) - n, " %s %llu%%", top[best].name, top[best].delta * 100 / (window ? window : 1));
+		total += top[best].delta;
+		top[best].delta = 0;
+	}
+	for (int i = 0; i < TOP_SLOTS; i++) {
+		total += top[i].delta;
+		top[i].delta = 0;
+	}
+	printf("%s | sum %llu%%\n", line, total * 100 / (window ? window : 1));
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
