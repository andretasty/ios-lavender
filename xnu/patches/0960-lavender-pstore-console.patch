+/*
+ * lavender: mirror console output into Linux's ramoops console zone (ADT node
+ * "sweet-pstore", reg = PA and size), so the next recovery boot shows it in
+ * /sys/fs/pstore/console-ramoops-0. Ring with the persistent_ram_buffer header.
+ */
+static volatile uint32_t *sweet_ps;
+static uint32_t sweet_ps_cap;
+
+void sweet_pstore_append(const char *c, int size);
+
+void
+sweet_pstore_append(const char *c, int size)
+{
+	volatile uint32_t *h = sweet_ps;
+	if (h == NULL) {
+		return;
+	}
+	volatile uint8_t *d = (volatile uint8_t *)(h + 3);
+	uint32_t pos = h[1], used = h[2];
+	for (int i = 0; i < size; i++) {
+		d[pos] = (uint8_t)c[i];
+		pos = (pos + 1) % sweet_ps_cap;
+		if (used < sweet_ps_cap) {
+			used++;
+		}
+	}
+	h[1] = pos;
+	h[2] = used;
+}
+
+static void
+sweet_pstore_probe(void)
+{
+	DTEntry entry;
+	uint64_t const *reg;
+	unsigned int size;
+
+	if (SecureDTFindEntry("name", "sweet-pstore", &entry) != kSuccess ||
+	    SecureDTGetProperty(entry, "reg", (void const **)&reg, &size) != kSuccess || size < 16) {
+		return;
+	}
+	volatile uint32_t *h = (volatile uint32_t *)ml_io_map(reg[0], reg[1]);
+	if (h == NULL) {
+		return;
+	}
+	h[1] = 0;
+	h[2] = 0;
+	h[0] = 0x43474244;      /* PERSISTENT_RAM_SIG "DBGC" */
+	sweet_ps_cap = (uint32_t)reg[1] - 12;
+	sweet_ps = h;
+}
+
 static void
 fbcon_probe(void)
 {
+	sweet_pstore_probe();
+
