diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index 1d3ee17..bffaea5 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -352,11 +352,21 @@ AppleCLCD::start(IOService *provider)
 		IOLog("SWEET FB: no vsync timer\n");
 		return false;
 	}
-	fVig0 = (volatile uint32_t *)ml_io_map(0x05e05000, 0x1000);
-	fCtl0 = (volatile uint32_t *)ml_io_map(0x05e02000, 0x1000);
+	/*
+	 * MDSS base (VIG0 +0x5000, CTL0 +0x2000, DSI0 +0x94000): topaz 0x5e00000 by
+	 * default, from the disp0 "mdss-base" property otherwise; 0 = no MDP/DSI
+	 * access at all (the boot framebuffer is only copied into).
+	 */
+	uint64_t mdss = 0x05e00000;
+	OSData *mdssProp = OSDynamicCast(OSData, provider->getProperty("mdss-base"));
+	if (mdssProp != NULL && mdssProp->getLength() == sizeof(mdss)) {
+		memcpy(&mdss, mdssProp->getBytesNoCopy(), sizeof(mdss));
+	}
+	fVig0 = mdss ? (volatile uint32_t *)ml_io_map(mdss + 0x5000, 0x1000) : NULL;
+	fCtl0 = mdss ? (volatile uint32_t *)ml_io_map(mdss + 0x2000, 0x1000) : NULL;
 	topaz_adreno_init();
 	setProperty("RedwoodWaitsForGPU", true);         /* present() waits for the GPU (eagl.c reads it) */
-	fDsi = (volatile uint8_t *)ml_io_map(0x05e94000, 0x1000);
+	fDsi = mdss ? (volatile uint8_t *)ml_io_map(mdss + 0x94000, 0x1000) : NULL;
 	fDsiBuf = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task,
 	    kIODirectionInOut | kIOMemoryPhysicallyContiguous, page_size, 0x00000000fffff000ull);
 	fDsiBufPhys = fDsiBuf ? fDsiBuf->getPhysicalSegment(0, NULL, kIOMemoryMapperNone) : 0;
@@ -399,7 +409,7 @@ AppleCLCD::start(IOService *provider)
 	}
 	OSSafeReleaseNULL(accel);
 	/* dpu sm6115 catalog: intf_1 at mdp+0x6a800, mdp at 0x5e01000 */
-	fIntf1 = (volatile uint32_t *)ml_io_map(0x05e6b000, 0x1000);
+	fIntf1 = mdss == 0x05e00000 ? (volatile uint32_t *)ml_io_map(0x05e6b000, 0x1000) : NULL;   /* DPU only */
 	if (fIntf1 != NULL) {
 		volatile uint32_t *r = fIntf1 + 0x800 / 4;
 		r[0x0a8 / 4] = 0x3;     /* FRAME_LINE_COUNT_EN */
