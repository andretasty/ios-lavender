+/* ---------------------------------------------------------------- measurements (boot-arg gpu_meas=1) */
+
+extern "C" {
+extern uint64_t semmc_rd_bytes, semmc_rd_abs, semmc_wr_bytes, semmc_wr_abs;     /* bsd/dev/sweet_emmc.c */
+extern uint64_t sweet_m_drawn_abs, sweet_m_latch_abs;                           /* SweetFramebuffer.cpp */
+extern uint32_t sweet_m_frames;
+}
+
+static uint64_t
+abs_us(uint64_t delta)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(delta, &ns);
+	return ns / 1000;
+}
+
+/* MB/s of the best of 3 runs of one operation over a buffer */
+enum { M_READ, M_WRITE, M_COPY };
+static uint64_t
+mem_rate(uint8_t *p, uint64_t size, int op)
+{
+	uint64_t best = ~0ull;
+
+	for (int run = 0; run < 3; run++) {
+		uint64_t t0 = mach_absolute_time();
+		if (op == M_READ) {
+			uint64_t sum = 0;
+			for (uint64_t i = 0; i < size; i += 8) {
+				sum += *(volatile uint64_t *)(p + i);
+			}
+			(void)sum;
+		} else if (op == M_WRITE) {
+			memset(p, run, size);
+		} else {
+			memcpy(p, p + size / 2, size / 2);
+		}
+		__asm__ volatile ("dsb sy" ::: "memory");
+		uint64_t us = abs_us(mach_absolute_time() - t0);
+		best = us < best ? us : best;
+		IOSleep(5);
+	}
+	return best == 0 ? 0 : (op == M_COPY ? size / 2 : size) / best;
+}
+
+static void
+mem_bench(const char *tag)
+{
+	const uint64_t size = 32u << 20;
+	IOBufferMemoryDescriptor *md = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task, kIODirectionInOut, size, PAGE_SIZE);
+
+	if (md != NULL) {
+		uint8_t *p = (uint8_t *)md->getBytesNoCopy();
+		bzero(p, size);
+		IOLog("MEAS %s: RAM cached 32 MB: read %llu MB/s, write %llu MB/s, copy %llu MB/s\n", tag,
+		    mem_rate(p, size, M_READ), mem_rate(p, size, M_WRITE), mem_rate(p, size, M_COPY));
+		md->release();
+	}
+	void *va = NULL;
+	uint64_t pa = topaz_gpu_pool_alloc(8u << 20, &va);
+	if (pa != 0) {
+		IOLog("MEAS %s: GPU pool (write-combined) 8 MB: read %llu MB/s, write %llu MB/s\n", tag,
+		    mem_rate((uint8_t *)va, 8u << 20, M_READ), mem_rate((uint8_t *)va, 8u << 20, M_WRITE));
+		topaz_gpu_pool_free(pa, 8u << 20);
+	}
+}
+
+static void
+gpu_measure(__unused void *param, __unused wait_result_t wr_)
+{
+	uint64_t rb = 0, ra = 0, wb = 0, wa = 0, da = 0, la = 0;
+	uint32_t f = 0;
+
+	mem_bench("start");
+	for (uint32_t window = 0;; window++) {
+		uint32_t busy = 0, samples = 0;
+		uint64_t t0 = mach_absolute_time();
+
+		while (abs_us(mach_absolute_time() - t0) < 5000000) {
+			samples++;
+			busy += (gpu_rd(0x4f5) >> 31) & 1;              /* RBBM_STATUS.GPU_BUSY_IGN_AHB */
+			IOSleep(1);
+		}
+		uint64_t nrb = semmc_rd_bytes, nra = semmc_rd_abs, nwb = semmc_wr_bytes, nwa = semmc_wr_abs, nda = sweet_m_drawn_abs, nla = sweet_m_latch_abs;
+		uint32_t nf = sweet_m_frames, df = nf - f;
+		uint64_t rus = abs_us(nra - ra), wus = abs_us(nwa - wa);
+		IOLog("MEAS: GPU busy %u%% | frames %u: wait GPU %llu us, latch %llu us | disk read %llu KB in %llu ms (%llu MB/s), write %llu KB in %llu ms (%llu MB/s)\n",
+		    samples ? busy * 100 / samples : 0, df, df ? abs_us(nda - da) / df : 0, df ? abs_us(nla - la) / df : 0,
+		    (nrb - rb) >> 10, rus / 1000, rus ? (nrb - rb) / rus : 0, (nwb - wb) >> 10, wus / 1000, wus ? (nwb - wb) / wus : 0);
+		rb = nrb; ra = nra; wb = nwb; wa = nwa; da = nda; la = nla; f = nf;
+		if (window == 11) {
+			mem_bench("busy");
+		}
+	}
+}
